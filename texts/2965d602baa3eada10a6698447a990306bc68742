    // The levels above the code - containers from directories, the calls
    // between them, the components inside each, a call nothing answers - and
    // the code of one file with stand-ins for what it reaches beyond itself.
    #[test]
    fn the_levels_roll_calls_up_from_functions_to_containers() {
        let (p, caches, m) = project(
            "levels",
            &[
                (
                    "api/server.py",
                    "from core.store import save\n\n# ccc:calls http billing.charge\ndef handle(x):\n    return save(x)\n",
                ),
                ("core/store.py", "def save(x):\n    return clean(x)\n\ndef clean(x):\n    return x\n"),
            ],
        );
        let o = m.overview();
        assert_eq!(o["schema"], SCHEMA);
        let names: Vec<&str> = o["containers"].as_array().unwrap().iter().map(|c| c["name"].as_str().unwrap()).collect();
        assert_eq!(names, ["api", "core"]);
        let edge = o["container_edges"]
            .as_array()
            .unwrap()
            .iter()
            .find(|e| e["from"] == "api" && e["to"] == "core")
            .unwrap_or_else(|| panic!("api calls core: {o:#}"));
        assert_eq!(edge["detected"], true);
        assert!(edge["symbols"].as_array().unwrap().iter().any(|s| s == "save"));
        assert!(o["component_edges"]
            .as_array()
            .unwrap()
            .iter()
            .any(|e| e["from"] == "api/server.py" && e["to"] == "core/store.py"));
        // nothing answers the annotated call, so it leaves the map
        let outside = &o["outside"][0];
        assert_eq!(outside["direction"], "out");
        assert_eq!(outside["transport"], "http");
        assert_eq!(outside["containers"][0]["container"], "api");

        let code = m.code(&caches, "core/store.py").unwrap();
        let fns: Vec<&str> = code["functions"].as_array().unwrap().iter().map(|f| f["name"].as_str().unwrap()).collect();
        assert_eq!(fns, ["save", "clean"]);
        assert!(code["proxies"].as_array().unwrap().iter().any(|x| x["name"] == "handle" && x["file"] == "api/server.py"));
        let clean = code["functions"][1]["id"].clone();
        assert!(code["functions"][0]["calls"].as_array().unwrap().iter().any(|c| c["to"] == clean));
        assert!(m.code(&caches, "nowhere.py").is_err());

        // a call step names the definition it reaches, across files
        let v = m.flow(&caches, &p.0, "api/server.py", 4, Some("handle")).unwrap();
        assert_eq!(v["steps"][0]["name"], "save");
        assert_eq!(v["steps"][0]["target"]["file"], "core/store.py");
        assert_eq!(v["params"][0], "x");
        assert!(m.flow(&caches, &p.0, "api/server.py", 99, None).is_err());
    }

    fn step(status: &'static str, files: &[(&str, Option<&str>, Option<&str>)]) -> edit::Activity {
        edit::Activity {
            changeset: "c1-test".into(),
            status,
            ops: vec!["text".into()],
            intent: Vec::new(),
            files: files
                .iter()
                .map(|(path, before, after)| edit::FileText {
                    path: path.to_string(),
                    before: before.map(str::to_string),
                    after: after.map(str::to_string),
                })
                .collect(),
        }
    }

    fn lang_of(path: &str) -> Option<Language> {
        Language::from_path(Path::new(path))
    }

    // Reflowing a function - re-indenting it, wrapping a long call - moves none
    // of its logic: the step says so, and is seen where something did change.
    #[test]
    fn a_change_of_layout_alone_is_no_change() {
        let before = "fn a(x: i32) -> i32 {\n    b(x, 1)\n}\n\nfn b(x: i32, y: i32) -> i32 {\n    x + y\n}\n";
        let after = "fn a(x: i32) -> i32 {\n    b(\n        x,\n        1,\n    )\n}\n\nfn b(x: i32, y: i32) -> i32 {\n    x - y\n}\n";
        let ev = event(1, 0, "edit_text", &step("applied", &[("src/a.rs", Some(before), Some(after))]), lang_of);
        let ws: Vec<(&str, bool)> = ev.json["functions"]
            .as_array()
            .unwrap()
            .iter()
            .map(|t| (t["name"].as_str().unwrap(), t["whitespace"].as_bool().unwrap()))
            .collect();
        assert_eq!(ws, [("a", true), ("b", false)], "wrapping a call is layout, a new operator is not");
        assert_eq!(ev.json["whitespace"], false);
        // seen where its logic changed, not where it was only rewrapped
        let Focus::Flow(t) = &ev.focus else { panic!("{:?}", ev.focus) };
        assert_eq!(t.name, "b");

        let spaced = before.replace("b(x, 1)", "b(x,   1)");
        let only = event(2, 0, "edit_text", &step("applied", &[("src/a.rs", Some(before), Some(&spaced))]), lang_of);
        assert_eq!(only.json["whitespace"], true);
        assert_eq!(only.json["files"][0]["whitespace"], true);
    }

    // One line written into one function: the step is seen at that function's
    // logic, both sides of it draw, and the lines it moved are named on each.
    #[test]
    fn an_edit_inside_one_function_is_seen_at_its_logic() {
        let before = "fn a() {\n    b();\n}\n\nfn b() {}\n\nfn c() {\n    b();\n}\n";
        let after = "fn a() {\n    b();\n    c();\n}\n\nfn b() {}\n\nfn c() {\n    b();\n}\n";
        let (_p, caches, m) = project("event-one", &[("src/calls.rs", before)]);
        let s = step("staged", &[("src/calls.rs", Some(before), Some(after))]);
        let ev = event(1, 0, "edit_text", &s, lang_of);
        let Focus::Flow(t) = &ev.focus else { panic!("{:?}", ev.focus) };
        assert_eq!((t.name.as_str(), t.change), ("a", "modified"));
        assert_eq!((t.before, t.after), (Some((1, 1, 3)), Some((1, 1, 4))));
        // the new call is line 3 after; before, it lands ahead of the `}` on line 3
        assert_eq!((t.lines_before.as_slice(), t.lines_after.as_slice()), (&[(3, 3)][..], &[(3, 3)][..]));
        assert_eq!(ev.json["on_disk"], "before");
        assert_eq!((ev.json["files"][0]["added"].as_u64(), ev.json["files"][0]["removed"].as_u64()), (Some(1), Some(0)));
        assert_eq!(ev.json["functions"].as_array().map(Vec::len), Some(1), "b and c only moved");

        let calls = |v: Option<Arc<Value>>| {
            let mut out = Vec::new();
            shape(&v.expect("a snapshot")["steps"], &mut out);
            out
        };
        assert_eq!(calls(m.snapshot(&caches, &s, &ev.focus, false)), ["call b"]);
        // the step is not written, yet its logic draws from the text it carries
        assert_eq!(calls(m.snapshot(&caches, &s, &ev.focus, true)), ["call b", "call c"]);
    }

    // a step widens from one function to its file, to the whole map, and to
    // nothing the map draws as it touches more
    #[test]
    fn a_step_is_seen_at_the_narrowest_level_that_holds_it() {
        let two = ("a.rs", Some("fn a() { x(); }\nfn b() { x(); }\n"), Some("fn a() { y(); }\nfn b() { y(); }\n"));
        let doc = ("README.md", Some("# a\n"), Some("# b\n"));
        let other = ("b.rs", Some("fn c() {}\n"), Some("fn c() { z(); }\n"));
        let focus = |files: &[(&str, Option<&str>, Option<&str>)]| event(1, 0, "t", &step("applied", files), lang_of).focus;
        assert_eq!(focus(&[two]), Focus::Code("a.rs".into()));
        assert_eq!(focus(&[two, other]), Focus::Overview);
        assert_eq!(focus(&[doc]), Focus::Nowhere);
        // one function and a note elsewhere is still that function's logic
        let Focus::Flow(t) = focus(&[other, doc]) else { panic!() };
        assert_eq!(t.name, "c");

        // a new function has no before side; where it lands is kept instead
        let add = ("a.rs", Some("fn a() {}\n"), Some("fn a() {}\n\nfn n() { a(); }\n"));
        let Focus::Flow(t) = focus(&[add]) else { panic!() };
        assert_eq!((t.name.as_str(), t.change, t.before), ("n", "added", None));
        assert_eq!(t.lines_before, [(2, 2)]);
        let gone = ("a.rs", Some("fn a() {}\n\nfn n() { a(); }\n"), Some("fn a() {}\n"));
        let Focus::Flow(t) = focus(&[gone]) else { panic!() };
        assert_eq!((t.change, t.after), ("removed", None));

        // a change inside a nested function is seen at the innermost one
        let nested = (
            "n.py",
            Some("def outer():\n    def inner():\n        x()\n    inner()\n"),
            Some("def outer():\n    def inner():\n        y()\n    inner()\n"),
        );
        let Focus::Flow(t) = focus(&[nested]) else { panic!() };
        assert_eq!(t.name, "inner");
    }

    #[test]
    fn a_callee_reads_as_its_name_and_qualifier() {
        assert_eq!(split_callee("billing::charge"), (Some("billing".into()), "charge".into()));
        assert_eq!(split_callee("Vec::<u8>::new"), (Some("Vec".into()), "new".into()));
        assert_eq!(split_callee("self.client.send"), (Some("self.client".into()), "send".into()));
        assert_eq!(split_callee("ptr->run"), (Some("ptr".into()), "run".into()));
        assert_eq!(split_callee("plain"), (None, "plain".into()));
        assert_eq!(arm_text("Some(x) if x > 0 => {"), "Some(x) if x > 0");
        assert_eq!(arm_text("case Foo::Bar: go();"), "Foo::Bar");
        assert_eq!(arm_text("default: e();"), "default");
        assert_eq!(arm_text("case: e()"), "");
    }

    // A step that adds an import, a constant and a function, and calls the new
    // function from an old one, plays as a part per definition - imports, then
    // what it adds, then what it changes - each part starting where the last
    // left off, and the last leaving exactly what the step wrote.
    #[test]
    fn a_step_comes_apart_a_definition_at_a_time() {
        let before = "use std::fs;\n\npub fn build(files: &[u8]) -> usize {\n    let n = files.len();\n    n\n}\n\nfn other() {}\n";
        let after = "use std::fs;\nuse std::thread;\n\npub fn build(files: &[u8]) -> usize {\n    let n = parse_all(files);\n    n\n}\n\n// how many workers\nconst WORKERS: usize = 4;\n\n// parse on every core\nfn parse_all(files: &[u8]) -> usize {\n    files.len() / WORKERS\n}\n\nfn other() {}\n";
        let parts = split(&step("applied", &[("src/a.rs", Some(before), Some(after))]), lang_of);
        let labels: Vec<(&str, Option<&str>, &str)> = parts
            .iter()
            .map(|(_, p)| {
                let p = p.as_ref().expect("a part");
                (p.kind, p.name.as_deref(), p.change)
            })
            .collect();
        assert_eq!(
            labels,
            [
                ("imports", None, "added"),
                ("const", Some("WORKERS"), "added"),
                ("function", Some("parse_all"), "added"),
                ("function", Some("build"), "modified"),
            ]
        );
        for w in parts.windows(2) {
            assert_eq!(w[0].0.files[0].after, w[1].0.files[0].before);
        }
        assert_eq!(parts[0].0.files[0].before.as_deref(), Some(before));
        assert_eq!(parts[3].0.files[0].after.as_deref(), Some(after));
        // a new function arrives whole, its comment with it, before anything calls it
        let added = parts[2].0.files[0].after.as_deref().unwrap();
        assert_eq!(added, after.replace("let n = parse_all(files);", "let n = files.len();"));
        let ev = event(1, 0, "edit_text", &parts[2].0, lang_of);
        let Focus::Flow(t) = &ev.focus else { panic!("{:?}", ev.focus) };
        assert_eq!((t.name.as_str(), t.change), ("parse_all", "added"));

        // a function added after the one that calls it comes apart from the call,
        // though the diff paired its closing brace with the caller's
        let before = "pub fn charge(n: i32) -> i32 {\n    n\n}\n";
        let after = "pub fn charge(n: i32) -> i32 {\n    fee(n)\n}\n\npub fn fee(n: i32) -> i32 {\n    n / 100\n}\n";
        let parts = split(&step("staged", &[("src/pay.rs", Some(before), Some(after))]), lang_of);
        let labels: Vec<(Option<&str>, &str)> =
            parts.iter().filter_map(|(_, p)| p.as_ref()).map(|p| (p.name.as_deref(), p.change)).collect();
        assert_eq!(labels, [(Some("fee"), "added"), (Some("charge"), "modified")]);
        assert_eq!(parts[0].0.files[0].after.as_deref(), Some("pub fn charge(n: i32) -> i32 {\n    n\n}\n\npub fn fee(n: i32) -> i32 {\n    n / 100\n}\n"));

        // a change to one definition is one part, so the step stays whole
        let one = before.replace("files.len()", "files.len() + 1");
        let whole = split(&step("applied", &[("src/a.rs", Some(before), Some(&one))]), lang_of);
        assert_eq!((whole.len(), whole[0].1.is_none()), (1, true));
    }

    // what an agent read, it is seen looking at: the definition it looked up,
    // with the functions that call it marked alongside
    #[test]
    fn a_look_is_seen_at_what_it_looked_up() {
        let src = "fn charge() {}\n\nfn refund() {\n    charge();\n}\n";
        let (_p, caches, _m) = project("look", &[("src/pay.rs", src)]);
        let sites = [("src/pay.rs".to_string(), 1, true), ("src/pay.rs".to_string(), 4, false)];
        let ev = look(0, "references", "charge", &sites, &caches).expect("a look");
        let Focus::Flow(t) = &ev.focus else { panic!("{:?}", ev.focus) };
        assert_eq!((t.name.as_str(), t.change), ("charge", "read"));
        assert_eq!(ev.json["status"], "read");
        assert_eq!(ev.json["intent"], json!(["references charge"]));
        let names: Vec<&str> = ev.json["functions"].as_array().unwrap().iter().map(|f| f["name"].as_str().unwrap()).collect();
        assert_eq!(names, ["charge", "refund"]);
        let file = look(0, "file", "src/pay.rs", &[("src/pay.rs".to_string(), 0, true)], &caches).expect("a look");
        assert_eq!(file.focus, Focus::Code("src/pay.rs".into()));
        assert!(look(0, "file", "ghost.rs", &[("ghost.rs".to_string(), 0, true)], &caches).is_none());
    }
