    #[test]
    fn copilots_patch_log_replays_into_the_requests_it_recorded() {
        let dir = tempdir::Dir::new("prompt-copilot");
        let file = write(
            dir.path(),
            "c1.jsonl",
            &[
                serde_json::json!({"kind": 0, "v": {"sessionId": "c1", "requests": []}}),
                serde_json::json!({"kind": 2, "k": ["requests"], "v": [{
                    "requestId": "r1", "timestamp": 1_787_000_000_000i64,
                    "message": {"text": "extract this into a helper"},
                }]}),
                // an unrelated set must not clobber the request list
                serde_json::json!({"kind": 1, "k": ["inputState", "inputText"], "v": "@workspace "}),
                serde_json::json!({"kind": 2, "k": ["requests"], "v": [{
                    "requestId": "r2", "timestamp": 1_787_000_060_000i64,
                    "message": {"text": "now add a test for it"},
                }]}),
            ],
        );
        let turns = parse_copilot(&file);
        assert_eq!(turns.len(), 2, "both appends replayed: {turns:#?}");
        assert_eq!(turns[0].prompt, "extract this into a helper");
        assert_eq!(turns[1].prompt, "now add a test for it");
        assert_eq!(turns[0].agent, "copilot");
        assert!(turns[0].edits.is_empty(), "copilot's log carries no edit payload");
        assert!(turns[1].epoch > turns[0].epoch);
    }

