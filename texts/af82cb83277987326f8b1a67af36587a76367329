                        "file_path": "/proj/src/lib.rs",
                        "edits": [
                            {"old_string": "fn old_a() {}", "new_string": "fn renamed_a() { /* first hunk */ }"},
                            {"old_string": "fn old_b() {}", "new_string": "fn renamed_b() { /* second hunk */ }"},
